# ─────────────────────────────────────────────────────────────────────────────
# SUNLEON AI environment variables. Copy to `.env` for local development and set
# the same keys in Vercel → Project → Settings → Environment Variables.
# Everything here is PLATFORM-WIDE. Per-business credentials (WhatsApp access
# tokens, Instagram tokens) are entered in the app and stored encrypted in the
# database — they never go in environment variables.
# See docs/ENVIRONMENT_VARIABLES.md for details.
# ─────────────────────────────────────────────────────────────────────────────

# Public base URL of the app (no trailing slash). Used for links in emails,
# OAuth redirect URIs and webhook callback URLs.
APP_URL=http://localhost:3000

# live    → outbound WhatsApp/Instagram messages are sent to Meta.
# sandbox → outbound messages are recorded but never sent (default outside production).
OUTBOUND_MESSAGING_MODE=sandbox

# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled connection string (Neon "-pooler" host) used at runtime.
DATABASE_URL=postgresql://sunleon:sunleon_dev_pw@localhost:5440/sunleon
# Direct (non-pooled) connection used by `prisma migrate`.
DIRECT_URL=postgresql://sunleon:sunleon_dev_pw@localhost:5440/sunleon
# Optional: shadow database for `prisma migrate dev` (local development only).
SHADOW_DATABASE_URL=

# ── Security ────────────────────────────────────────────────────────────────
# 32+ random bytes, e.g. `openssl rand -base64 48`. Keys session/token hashing.
AUTH_SECRET=
# Exactly 32 bytes, base64 encoded: `openssl rand -base64 32`.
# Encrypts integration credentials and MFA secrets at rest (AES-256-GCM).
ENCRYPTION_KEY=
# Shared secret Vercel Cron sends as `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=
# Comma-separated emails promoted to platform super-admin by `npm run db:seed`.
PLATFORM_ADMIN_EMAILS=

# ── AI (Anthropic Claude) ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_STANDARD=claude-sonnet-5-5
ANTHROPIC_MODEL_ADVANCED=claude-opus-5-5

# ── Embeddings (Voyage AI, optional — falls back to full-text search) ───────
VOYAGE_API_KEY=
VOYAGE_MODEL=voyage-4-lite

# ── Meta (WhatsApp Cloud API + Instagram API with Instagram Login) ─────────
META_GRAPH_API_VERSION=v27.0
META_APP_ID=
META_APP_SECRET=
# Any random string; enter the same value in the Meta app webhook settings.
META_WEBHOOK_VERIFY_TOKEN=
# WhatsApp Embedded Signup configuration id (Meta app → WhatsApp → Embedded Signup).
META_WHATSAPP_CONFIG_ID=
# Instagram Login uses the Instagram app id/secret shown under
# Meta app → Instagram → API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# ── Payments (Paystack) ─────────────────────────────────────────────────────
# Paystack signs webhooks with the secret key; there is no separate webhook secret.
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# When empty, emails are written to the server log instead of being sent.
RESEND_API_KEY=
EMAIL_FROM=SUNLEON AI <no-reply@example.com>

# ── Object storage (S3-compatible, e.g. Cloudflare R2) ──────────────────────
# When empty in development, files are stored under ./.data/storage.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# ── Background jobs ─────────────────────────────────────────────────────────
# inline → jobs run right after the response via next/server `after()`
#          plus the cron sweeper (no external service).
# qstash → Upstash QStash delivers wake-ups and delayed retries.
QUEUE_PROVIDER=inline
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
